# Nagios Bulk Editor — Apache reverse proxy configuration
#
# Serves the editor at /editor/ alongside the Nagios web UI at /nagios/.
# The systemd unit sets SCRIPT_NAME=/editor so Flask generates correct URLs.
#
# Install:
#   sudo cp deploy/apache.conf.example /etc/apache2/conf-available/nagios-bulk-editor.conf
#   sudo a2enmod proxy proxy_http headers
#   sudo a2enconf nagios-bulk-editor
#   sudo systemctl reload apache2

ProxyPass        /editor/ http://127.0.0.1:8080/editor/
ProxyPassReverse /editor/ http://127.0.0.1:8080/editor/

<Location /editor/>
    # Optional: protect with the same basic auth as your Nagios web UI.
    # Uncomment and adjust AuthUserFile to match your setup.
    #
    # AuthType Basic
    # AuthName "Nagios Bulk Editor"
    # AuthUserFile /usr/local/nagios/etc/htpasswd.users
    # Require valid-user
    #
    # With auth on, pass the logged-in user to the editor so the audit log
    # records who really made each change (instead of the name and email the
    # browser claims). `set` overwrites any X-Remote-User the client sends.
    # Also uncomment NBE_TRUSTED_USER_HEADER in the systemd unit.
    #
    # RequestHeader set X-Remote-User expr=%{REMOTE_USER}

    RequestHeader set X-Forwarded-Proto expr=%{REQUEST_SCHEME}
    RequestHeader set X-Forwarded-For expr=%{REMOTE_ADDR}
</Location>
